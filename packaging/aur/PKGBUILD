# Maintainer: yuukiflow <yuukiflow@users.noreply.github.com>
# AUR package for the prebuilt static release. After a new release:
#   update pkgver, then `updpkgsums && makepkg --printsrcinfo > .SRCINFO`
pkgname=ngx-bin
pkgver=0.3.0
pkgrel=1
pkgdesc="Manage nginx sites and Let's Encrypt certificates: status, safe validated changes, history/undo, dashboard"
arch=('x86_64' 'aarch64')
url="https://github.com/yuukiflow/ngx"
license=('unknown')  # set once the project has a license
depends=('nginx')
optdepends=('certbot: Let'\''s Encrypt certificates'
            'curl: ngx check notifications')
provides=('ngx')
conflicts=('ngx')
source_x86_64=("https://github.com/yuukiflow/ngx/releases/download/v$pkgver/ngx-v$pkgver-x86_64-unknown-linux-musl.tar.gz")
source_aarch64=("https://github.com/yuukiflow/ngx/releases/download/v$pkgver/ngx-v$pkgver-aarch64-unknown-linux-musl.tar.gz")
sha256sums_x86_64=('SKIP')  # replaced by updpkgsums
sha256sums_aarch64=('SKIP')

package() {
  cd "ngx-v$pkgver-$CARCH-unknown-linux-musl"
  install -Dm755 ngx "$pkgdir/usr/bin/ngx"
  install -Dm644 -t "$pkgdir/usr/share/man/man1" man/*.1
  install -Dm644 completions/ngx.bash "$pkgdir/usr/share/bash-completion/completions/ngx"
  install -Dm644 completions/_ngx "$pkgdir/usr/share/zsh/site-functions/_ngx"
  install -Dm644 completions/ngx.fish "$pkgdir/usr/share/fish/vendor_completions.d/ngx.fish"
  install -Dm644 README.md "$pkgdir/usr/share/doc/ngx/README.md"
}
