(( $+functions[_ngx_commands] )) ||
_ngx_commands() {
    local commands; commands=(
'ls:List sites with status, SSL, renewal, ports and errors' \
'show:Show everything about one site\: SSL, routing, backend process, locations, logs, traffic' \
'add:Create and enable a new site (asks for anything not given as a flag)' \
'edit:Change a site'\''s settings\: same questions as \`add\`, pre-filled with the current values' \
'rm:Remove a site'\''s configuration (a backup is kept)' \
'enable:Enable a disabled site' \
'disable:Disable a site without deleting it (\`ngx enable\` brings it back with the same ID)' \
'suspend:Suspend a site\: every request gets a 503 and a notice page (\`ngx resume\` brings it back as it was)' \
'resume:Bring a suspended site back' \
'cert:Certificates\: info, issue, renew, auto-renewal on/off (wraps certbot)' \
'logs:Show a site'\''s access log (or error log with -e)' \
'test:Validate the nginx configuration (\`nginx -t\`)' \
'reload:Validate, then reload nginx (waits until the new config is live)' \
'doctor:Check the environment\: nginx, certbot, layout, renewal timer, permissions' \
'regen:Rewrite ngx-managed sites with the current template (after an upgrade)\: diffs, one confirmation, one nginx -t' \
'split:Split a file that defines several sites into one file per site (so each can be edited on its own)' \
'auth:Users of password-protected sites (basic auth)' \
'check:Check every site for monitoring/cron\: down sites, expired or expiring certificates, renewal problems' \
'history:List recorded changes (newest first), optionally only those touching one site' \
'undo:Undo a change\: restore every file it touched (default\: the latest change)' \
'init:Create sites-available/ + sites-enabled/ and include them from nginx.conf (Arch, RHEL, …)' \
